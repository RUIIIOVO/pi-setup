+// claudeGateUARe matches the canonical Claude Code User-Agent shape that
+// Anthropic parses for its minimum-version model gate.
+var claudeGateUARe = regexp.MustCompile(`(?i)^claude-cli/([0-9]+(?:\.[0-9]+){0,3})\s+\(external,\s*[^)]+\)`)
