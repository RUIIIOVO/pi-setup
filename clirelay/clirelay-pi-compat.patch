+	got := modelIDsOf(dropDisabledModels(models, ""))
+
+	want := []string{"claude-opus-5", "claude-fable-5-1"}
+	if len(got) != len(want) {
+		t.Fatalf("ids = %v, want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("ids = %v, want %v", got, want)
+		}
+	}
+}
